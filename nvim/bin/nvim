#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# XDG dirs -> keep everything inside this folder
export XDG_CONFIG_HOME="$ROOT"
export XDG_DATA_HOME="$ROOT/.local"
export XDG_STATE_HOME="$ROOT/.state"
export XDG_CACHE_HOME="$ROOT/.cache"

# Force Neovim to use this init.lua explicitly
exec nvim -u "$ROOT/init.lua" "$@"
